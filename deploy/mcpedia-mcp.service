[Unit]
Description=MCPedia MCP server (Streamable HTTP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/code/mcpedia
# Loads DATABASE_URL, EMBED_* from the repo .env (MCP tools read the KB).
EnvironmentFile=/home/code/mcpedia/.env
# Absolute bun path (systemd has a minimal PATH; /usr/bin/env bun fails).
Environment=MCP_PORT=4021
ExecStart=/home/code/.bun/bin/bun --cwd apps/mcp src/http.ts
Restart=on-failure
RestartSec=5
User=code
Group=code
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=512M
TasksMax=256

[Install]
WantedBy=multi-user.target
